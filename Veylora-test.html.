function updateCharacter(){
 const c=character;
 stops('skin',c.skin);stops('cloth',c.cloth);
 $('hairBack').setAttribute('d',hairShapes[c.hairStyle][0]);
 $('hairFront').setAttribute('d',hairShapes[c.hairStyle][1]);
 $('hairBack').setAttribute('fill',c.hair);$('hairFront').setAttribute('fill',c.hair);
 $('rightEye').setAttribute('ry',c.expression==='wink'?'1':'4');
 const mouths={smile:'M139 105 Q150 114 161 105',neutral:'M140 108 L160 108',surprised:'M145 104 Q150 116 155 104',wink:'M139 105 Q150 114 161 105'};
 $('mouth').setAttribute('d',mouths[c.expression]);
 const shirt=$('shirt'),bottom=$('bottom');
 shirt.setAttribute('fill','url(#clothGradient)');
 if(c.outfitStyle==='gown'){
  shirt.setAttribute('d','M128 137 Q150 150 172 137 L190 154 L204 235 L225 329 Q150 348 75 329 L96 235 L110 154Z');
  bottom.setAttribute('d','M75 329 Q150 350 225 329 L229 344 Q150 366 71 344Z');
  bottom.setAttribute('fill','url(#clothGradient)');
 }else if(c.outfitStyle==='hoodie'){
  shirt.setAttribute('d','M126 137 Q150 150 174 137 L194 154 L207 235 Q150 254 93 235 L106 154Z');
  bottom.setAttribute('d','M109 231 L191 231 L187 280 L113 280Z');bottom.setAttribute('fill','#282335');
 }else if(c.outfitStyle==='shirt'){
  shirt.setAttribute('d','M132 138 L150 153 L168 138 L190 154 L204 232 L96 232 L110 154Z');
  bottom.setAttribute('d','M109 231 L191 231 L187 280 L113 280Z');bottom.setAttribute('fill','#30293a');
 }else{
  shirt.setAttribute('d','M128 137 Q150 150 172 137 L190 154 L205 230 Q178 249 150 249 Q122 249 95 230 L110 154Z');
  bottom.setAttribute('d','M112 229 Q150 240 188 229 L196 278 Q150 293 104 278Z');bottom.setAttribute('fill','#352444');
 }
 $('charName').value=c.name;
 $('hairStyle').value=c.hairStyle;$('outfitStyle').value=c.outfitStyle;$('expression').value=c.expression;
 document.querySelectorAll('[data-skin]').forEach(b=>b.classList.toggle('selected',b.dataset.skin===c.skin));
 document.querySelectorAll('[data-hair]').forEach(b=>b.classList.toggle('selected',b.dataset.hair===c.hair));
 document.querySelectorAll('[data-cloth]').forEach(b=>b.classList.toggle('selected',b.dataset.cloth===c.cloth));
}
$('charName').oninput=e=>character.name=e.target.value;
$('hairStyle').onchange=e=>{character.hairStyle=e.target.value;updateCharacter()};
$('outfitStyle').onchange=e=>{character.outfitStyle=e.target.value;updateCharacter()};
$('expression').onchange=e=>{character.expression=e.target.value;updateCharacter()};
document.querySelectorAll('[data-skin]').forEach(b=>b.onclick=()=>{character.skin=b.dataset.skin;updateCharacter()});
document.querySelectorAll('[data-hair]').forEach(b=>b.onclick=()=>{character.hair=b.dataset.hair;updateCharacter()});
document.querySelectorAll('[data-cloth]').forEach(b=>b.onclick=()=>{character.cloth=b.dataset.cloth;updateCharacter()});
$('saveCharacter').onclick=()=>{
 data.characters.unshift({...character,id:'char_'+Date.now()});
 persist();renderCharacters();renderHome();notify('Character saved ✨');
};
$('resetCharacter').onclick=()=>{
 character={name:'Nova',hairStyle:'curly',outfitStyle:'dress',expression:'smile',skin:'#8d5439',hair:'#211323',cloth:'#a88be8'};
 updateCharacter();notify('Preview reset');
};
function renderCharacters(){
 const box=$('savedCharacters');box.replaceChildren();
 if(!data.characters.length){box.innerHTML='<div class="empty">Save your first character to see it here.</div>';return}
 data.characters.forEach(c=>{
  const card=document.createElement('div');card.className='story';
  const h=document.createElement('h3');h.textContent=c.name||'Unnamed character';
  const p=document.createElement('p');p.className='small';p.textContent=c.hairStyle+' hair · '+c.outfitStyle+' · '+c.expression;
  const row=document.createElement('div');row.className='btnrow';
  const edit=document.createElement('button');edit.className='btn primary';edit.textContent='Edit';
  edit.onclick=()=>{character={...c};updateCharacter();notify('Character loaded')};
  const del=document.createElement('button');del.className='btn';del.textContent='Delete';
  del.onclick=()=>{data.characters=data.characters.filter(x=>x.id!==c.id);persist();renderCharacters();renderHome()};
  row.append(edit,del);card.append(h,p,row);box.append(card);
 });
}

const sceneInfo={
 bedroom:{emoji:'🌙',caption:'A cosy room beneath the moonlight.',bg:'linear-gradient(#73558a,#38294f 58%,#6a456b 58%,#251a32)'},
 forest:{emoji:'🌲',caption:'A mysterious path beneath glowing trees.',bg:'linear-gradient(#183d43,#315b4b 58%,#192c2a 58%,#10191c)'},
 city:{emoji:'🌃',caption:'City lights sparkle beneath the midnight sky.',bg:'linear-gradient(#12182f,#424878 58%,#25233e 58%,#171321)'},
 beach:{emoji:'🌅',caption:'Sunset colours meet the quiet sea.',bg:'linear-gradient(#ef9a9a,#a96d9f 47%,#557e9c 48%,#1d435c)'},
 school:{emoji:'🏫',caption:'A classroom ready for a new day.',bg:'linear-gradient(#b7c8d6,#d9c7b5 58%,#7b655d 58%,#4c3a3a)'}
};
function updateScene(){
 const v=sceneInfo[$('sceneType').value];
 $('scenePreview').style.background=v.bg;$('sceneEmoji').textContent=v.emoji;
 $('sceneCaption').textContent=v.caption;$('scenePreviewName').textContent=$('sceneName').value||'Untitled Scene';
}
$('sceneType').onchange=updateScene;$('sceneName').oninput=updateScene;
$('saveScene').onclick=()=>{
 const type=$('sceneType').value;
 data.scenes.unshift({id:'scene_'+Date.now(),name:$('sceneName').value.trim()||'Untitled Scene',type});
 persist();renderScenes();notify('Scene saved');
};
function renderScenes(){
 const box=$('savedScenes');box.replaceChildren();
 if(!data.scenes.length){box.innerHTML='<div class="empty">Your saved scenes will appear here.</div>';return}
 data.scenes.forEach(s=>{
   const card=document.createElement('div');card.className='story';
  const h=document.createElement('h3');h.textContent=s.name;
  const p=document.createElement('p');p.className='small';p.textContent=s.type;
  const row=document.createElement('div');row.className='btnrow';
  const view=document.createElement('button');view.className='btn';view.textContent='Preview';
  view.onclick=()=>{$('sceneName').value=s.name;$('sceneType').value=s.type;updateScene()};
  const del=document.createElement('button');del.className='btn';del.textContent='Delete';
  del.onclick=()=>{data.scenes=data.scenes.filter(x=>x.id!==s.id);persist();renderScenes()};
  row.append(view,del);card.append(h,p,row);box.append(card);
 });
}
restoreLocal();renderHome();renderStories();renderCharacters();renderScenes();updateCharacter();updateScene();
</script>
